<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Meida.Desktop.ViewModels"
             x:DataType="vm:MetronomeViewModel"
             x:Class="Meida.Desktop.Views.HeaderMetronomeBeatsView">


    <ItemsControl IsVisible="{Binding IsPlaying}" ItemsSource="{Binding Beats}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Height="30" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" />

            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BeatItem">

                <Ellipse Classes="header-beat"
                         Classes.playing="{Binding $parent[ItemsControl].((vm:MetronomeViewModel)DataContext).IsPlaying}"
                         Classes.active="{Binding IsActive}"
                         Classes.accent="{Binding IsAccent}"
                         IsVisible="{Binding IsVisible}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>