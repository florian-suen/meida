<UserControl ZIndex="9999" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:vm="using:Meida.Desktop.ViewModels"
             xmlns:sortable="clr-namespace:Sortable.Avalonia;assembly=Sortable.Avalonia"
             x:DataType="vm:PlayerViewModel"
             x:Class="Meida.Desktop.Views.Chords.PlayerView">
    <UserControl.Styles>
        <Style Selector="sukiUi|GlassCard.current">

            <Setter Property="Background" Value="Aqua" />

        </Style>


        <Style Selector="ToggleButton.repeat-btn">
            <Setter Property="Foreground" Value="Gray" />
        </Style>


        <Style Selector="ToggleButton.repeat-btn:checked">
            <Setter Property="Foreground" Value="#AD3341" />
        </Style>


    </UserControl.Styles>

    <StackPanel HorizontalAlignment="Center" Spacing="20">
        <!--<ComboBox MaxWidth="200"
                  Margin="20,0,0,0"
                  PlaceholderText="Select a Key"
                  ItemsSource="{Binding BackgroundMusic}"
                  SelectedItem="{Binding SelectedItem}" />-->


        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="200">
            <Grid Width="{Binding BoardWidth}" Height="200">


                <Canvas>
                    <Rectangle Canvas.Top="20" Height="1" Fill="Gray" Width="{Binding BoardWidth}" />
                    <Rectangle Canvas.Top="45" Height="1" Fill="Gray" Width="{Binding BoardWidth}" />
                    <Rectangle Canvas.Top="70" Height="1" Fill="Gray" Width="{Binding BoardWidth}" />
                    <Rectangle Canvas.Top="95" Height="1" Fill="Gray" Width="{Binding BoardWidth}" />
                    <Rectangle Canvas.Top="120" Height="1" Fill="Gray" Width="{Binding BoardWidth}" />
                    <Rectangle Canvas.Top="145" Height="1" Fill="Gray" Width="{Binding BoardWidth}" />

                </Canvas>


                <ItemsControl ItemsSource="{Binding AllTabNotes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>


                        <ItemsControl.ItemContainerTheme>
                        </ItemsControl.ItemContainerTheme>


                        <DataTemplate x:DataType="vm:FingerPosition">
                            <Grid Canvas.Left="{Binding TimelineX}" Canvas.Top="{Binding TabY}">
                                <Ellipse Width="24" Height="24" Fill="#AD3341" Stroke="White" StrokeThickness="1" />
                                <TextBlock Text="{Binding FingerNumber}"
                                           Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Canvas IsHitTestVisible="False">
                    <Line Canvas.Left="{Binding PlayheadX}"
                          StartPoint="0,0" EndPoint="0,200"
                          Stroke="#AD3341" StrokeThickness="3" />
                </Canvas>

            </Grid>
        </ScrollViewer>
       
        
        
        <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Cursor="Hand" Padding="0" Margin="0" BorderThickness="0">
                <materialIcons:MaterialIcon Width="50" Kind="SkipPreviousOutline" />
            </Button>
            <Button Command="{Binding PlayCommand}" Cursor="Hand" Padding="0" Margin="0" BorderThickness="0">
                <materialIcons:MaterialIcon Width="60" Kind="PlayCircle" />
            </Button>
            <Button Cursor="Hand" Padding="0" Margin="0" BorderThickness="0">
                <materialIcons:MaterialIcon Width="50" Kind="SkipNextOutline" />
            </Button>

            <ToggleButton Classes="repeat-btn"
                          IsChecked="{Binding IsRepeating}"
                          Cursor="Hand"
                          Padding="0"
                          Margin="0"
                          BorderThickness="0"
                          Background="Transparent">
                <materialIcons:MaterialIcon Width="20" Kind="Repeat" />
            </ToggleButton>
        </StackPanel>
        
        
        
        <ItemsControl
            sortable:Sortable.Mode="Swap"
            sortable:Sortable.Sortable="True"
            sortable:Sortable.UpdateCommand="{Binding UpdateChordOrderCommand}"
            ItemsSource="{Binding SelectedChordsOrder}">
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter:nth-last-child(1) materialIcons|MaterialIcon.chevron-separator">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="10,50" ItemSpacing="10" LineSpacing="15"
                               HorizontalAlignment="Center" />

                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Cursor="Hand"
                            sortable:Sortable.IsSortable="True">
                        <StackPanel
                            Orientation="Horizontal" Spacing="10">
                            <sukiUi:GlassCard Classes.current="{Binding IsCurrent}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ChordName}" />
                                    <Button Cursor="Hand" Command="{Binding SelectChordCommand}"
                                            CommandParameter="{Binding . }"
                                            Padding="0" Foreground="White" Classes="Basic">
                                        <materialIcons:MaterialIcon Kind="CancelCircle" />
                                    </Button>
                                </StackPanel>
                            </sukiUi:GlassCard>
                            <materialIcons:MaterialIcon Classes="chevron-separator" Kind="ChevronRight" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>