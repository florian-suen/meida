<sukiUi:SukiWindow
    Padding="0"
    ShowBottomBorder="False"
    RootCornerRadius="20"
    CornerRadius="15"
    IsMenuVisible="False"
    BackgroundStyle="Bubble"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:Meida.Desktop.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    x:Class="Meida.Desktop.Views.MainWindow"
    xmlns:views="using:Meida.Desktop.Views"
    Title="Meida"
    Width="1024" Height="768"
    WindowDecorations="None"
    ExtendClientAreaToDecorationsHint="True"
    TransparencyBackgroundFallback="{DynamicResource SukiBackgroundSolid}"
    BorderBrush="#6DFF18"
    WindowStartupLocation="CenterScreen">

    <sukiUi:SukiWindow.Styles>
        <Style Selector="Ellipse.header-beat">
            <Setter Property="Fill" Value="#555555" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.header-beat.active">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Fill" Value="#9377C9" />
        </Style>
        <Style Selector="Ellipse.header-beat.active.accent">
            <Setter Property="Fill" Value="#2799CB" />
        </Style>
        <Style Selector="Ellipse.header-beat.playing">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </sukiUi:SukiWindow.Styles>
    <sukiUi:SukiWindow.Hosts>
        <sukiUi:SukiDialogHost Manager="{Binding DialogManager}" />
    </sukiUi:SukiWindow.Hosts>
    <Border BorderThickness="0,1,0,0" BorderBrush="#382738" Padding="0,10,0,0">
        <Grid RowDefinitions="50,*">
            <StackPanel Grid.Row="0" Spacing="5" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,0,16,10"
                        VerticalAlignment="Center">
                <views:HeaderMetronomeBeatsView DataContext="{Binding Metronome}"
                                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowHeaderBeats}" />
                <Button Command="{Binding OpenMetronomeCommand}" Padding="15" BorderThickness="0" Cursor="Hand"
                        Background="Transparent">
                    <Svg Path="/Assets/metronome.svg" Width="20" Height="20" HorizontalAlignment="Center" />
                </Button>
                <Separator Height="20" Width="1" />
                <Button Padding="15,0" Background="#A83A5C" BorderBrush="#7C303F" BorderThickness="1" Cursor="Hand">
                    <materialIcons:MaterialIcon Kind="Abacus" Width="20" />
                </Button>
            </StackPanel>
            <Border Grid.Row="1"
                    CornerRadius="20 ,0,0,20"
                    ClipToBounds="False"
                    BoxShadow="0 4 15 0 #40000000">
                <sukiUi:SukiSideMenu
                    ItemsSource="{Binding MenuItems, Mode=OneWay}"
                    SidebarToggleEnabled="True"
                    ClipToBounds="False"
                    IsSearchEnabled="True">
                    <sukiUi:SukiSideMenu.ItemTemplate>
                        <DataTemplate>
                            <sukiUi:SukiSideMenuItem />
                        </DataTemplate>
                    </sukiUi:SukiSideMenu.ItemTemplate>
                    <sukiUi:SukiSideMenu.HeaderContent>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="30,0">
                            <materialIcons:MaterialIcon Kind="Music" Width="32" Height="32" />
                            <TextBlock Text="Meida" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </sukiUi:SukiSideMenu.HeaderContent>
                    <sukiUi:SukiSideMenu.FooterContent>
                        <TextBlock Text="v1.0.0" Margin="21,0" Opacity="0.5" />
                    </sukiUi:SukiSideMenu.FooterContent>
                </sukiUi:SukiSideMenu>
            </Border>
        </Grid>
    </Border>
</sukiUi:SukiWindow>