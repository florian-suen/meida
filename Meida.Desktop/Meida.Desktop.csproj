<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework> <!-- Or net8.0/net9.0 depending on your setup -->
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Meida.Desktop</AssemblyName>
    <RootNamespace>Meida.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>

    <AvaloniaResource Include="Assets\**" />

    <Content Include="Assets\Sounds\Metronome.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>


    <Content Include="Assets\Sounds\MetronomeUp.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5"/>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5"/>
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5"/>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.13"/>
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.13"/>
    <PackageReference Include="IconPacks.Avalonia" Version="2.0.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2"/>
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
    <PackageReference Include="SukiUI" Version="7.0.2-nightly20261029.502"/>
    <PackageReference Include="SukiUI.Dock" Version="7.0.2-nightly20261029.502"/>
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17"/>
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2"/>
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Views\Chords\ChordsDiagramView.axaml" />
    <AdditionalFiles Include="Views\Chords\ChordsView.axaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Chords\ChordsDiagramView.axaml.cs">
      <DependentUpon>ChordsDiagramView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Chords\ChordsView.axaml.cs">
      <DependentUpon>ChordsView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Scales\ScalesView.axaml.cs">
      <DependentUpon>ScalesView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>
</Project>